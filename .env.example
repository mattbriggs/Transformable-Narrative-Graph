# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored.
# Docker Compose reads .env automatically for variable substitution.

# Neo4j credentials — used by both the neo4j and app containers.
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# Neo4j connection (used by the app outside of Compose, e.g. local dev)
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# Ingest pipeline tuning
CONFIDENCE_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
