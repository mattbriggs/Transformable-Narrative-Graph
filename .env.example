# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# Neo4j connection (use service name when running inside Compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# Path to a file containing "username/password" — injected as a Docker secret in Compose.
# For local dev outside Docker you may set NEO4J_USER and NEO4J_PASSWORD directly instead.
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# API security
API_SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY
API_TOKEN_EXPIRE_MINUTES=60

# Ingest pipeline tuning
CONFIDENCE_THRESHOLD=0.6

# Logging
LOG_LEVEL=INFO
